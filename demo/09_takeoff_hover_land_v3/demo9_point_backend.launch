<launch>
  <!-- Demo9 POINT only. EGO, D435i, QR and yaw bridge are intentionally NOT started. -->
  <!-- All controllers and safety gates remain in the frozen runtime package. -->
  <node pkg="ego_uav_interface" type="point_traj_node.py" name="point_traj_node" output="log">
    <param name="output_topic" value="/contest1/ego_uav_interface/point_setpoint"/>
    <param name="max_speed" value="0.20"/>
    <param name="takeoff_height" value="0.80"/>
    <param name="takeoff_speed" value="0.40"/>
    <param name="takeoff_acc" value="0.80"/>
    <!-- Baseline: exactly the original proven landing settings. -->
    <param name="land_speed" value="0.30"/>
    <param name="land_acc" value="0.60"/>
    <param name="land_terminal_range" value="0.10"/>
    <param name="land_terminal_speed" value="0.20"/>
    <param name="land_terminal_min_offset" value="-0.20"/>
    <param name="land_terminal_fault_grace" value="0.60"/>
    <param name="range_timeout" value="0.30"/>
    <remap from="/contest1/move_base_simple/goal" to="/contest1/ego_uav_interface/point_goal"/>
  </node>
  <node pkg="ego_uav_interface" type="trajectory_mux.py" name="trajectory_mux" output="log"/>
  <!-- Touchdown confirmation identical to the Demo8/7 baseline. -->
  <param name="/contest1/uav2_touchdown/range_threshold" value="0.08"/>
  <param name="/contest1/uav2_touchdown/range_timeout" value="0.30"/>
  <param name="/contest1/uav2_touchdown/stable_time" value="0.20"/>
  <param name="/contest1/uav2_touchdown/min_drop" value="0.30"/>
</launch>
